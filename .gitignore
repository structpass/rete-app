.claude/settings.local.json

# 開発エージェントライブUI検証の出力（スクショ等・コミット対象外）
dev-ui-verify/
.ui-evidence/
# scripts/ のアンダースコア始動 = 開発エージェントスクラッチ一式（UI Gate 証跡ステージング・curl ペイロード・使い捨て mjs 等。正本は Board・git add -A 誤コミット防止）
scripts/_*

# 廃止した旧領域の再作成・誤コミット防止（新規作業は tmp/）
/scratchpad/
/.scratchpad/
# 既存の root / packages 双方の除外範囲を維持する安全網
.scratch/
/.scratchpad-approved.json
# root 直下に漏れた旧スクラッチの誤コミット防止（先頭スラッシュで root 限定）
/scratch-*
/scratchpad-*

# 開発エージェントスクラッチ成果物（Board API ダンプ・UI 反復の中間生成物等。git add -A での誤コミット防止・rev-quality 2026-07-31）
# 先頭スラッシュ無し＝root / packages 配下の双方を捕捉する
.ui-iterate/
/.t.json
/=

# 開発エージェントスクラッチ（scripts/ 直下の dot 始まり = curl ペイロード / Board 応答 / 使い捨て mjs。
# 既存の scripts/_* と同趣旨で、命名が dot 始まりに寄った分を捕捉する。正本は Board）
/scripts/.*

# UI Gate 証跡・ライブ検証のスクショ（正本は Board の evidence。repo へは入れない＝実績としても plans/ に画像は1枚も track されていない）
/plans/*.png
/plans/*.jpg
/plans/_*

# Board API ダンプ（チケット一覧の使い捨て取得）
/.tmp-*.json

# Cline ハーネスのローカル状態（worktree / データ。設定・ルール本体は .clinerules/ = 追跡対象）
/.cline/

# 旧ツール時代の使い捨て成果物（dev-loop ログ・Windows リダイレクト事故ファイル・Board API ダンプ・Hermes プラン作業領域）
/.dev-loop-code-*.log
/NUL
/tickets*.json
/.hermes/

# Repository-local Corepack cache used by the agent test wrapper.
/.corepack-cache/

# cmdc（Command Code CLI）の cwd 設定と dsh プラグインビルド生成物（正本は ~/.commandcode・~/.dsh/plugins-src）
/.commandcode/
/.dsh-plugin-build/

# 開発用の監視スクリプトが実行時に書く直前の失敗記録（リポジトリの状態ではない）
/dev-watchdog-event-state.json
# 起動の印と、package ごとの dev ログ（実行時に書かれる一時物。起動の印は排他のため触らない）
/.dev-restart.lock
/dev-rete-*.log
/dev-rete-*.log.err

# d934: dev の立て直しで、前のログを握られて退避できない時の時刻付き別名（tmp/ ではなくここに出る）
/dev-*.log.*.log
/dev-*.log.*.log.err
